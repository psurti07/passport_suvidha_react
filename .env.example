# Passport Suvidha. Copy to .env.local and fill in. Never commit real values.
#
# Production builds read their defaults from .env.production. The live server still has to
# provide the backend and payment values below. A staging or preview deployment MUST set the
# "Staging" block, otherwise it is indexed and sends test traffic to the tracking accounts.

# --- Required on the live server ------------------------------------------------------
# Base URL of the Laravel API, no trailing slash
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_FRONTEND_URL=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Public Razorpay key id (never the secret)
NEXT_PUBLIC_RAZORPAY_KEY=
NEXT_PUBLIC_CASHFREE_MODE=

# --- Staging / preview ----------------------------------------------------------------
# NEXT_PUBLIC_SITE_ENV=preview
# NEXT_PUBLIC_ENABLE_TRACKING=false
# NEXT_PUBLIC_ENABLE_CHAT=false
# NEXT_PUBLIC_ENABLE_PAYMENT_SCRIPTS=false
# "true" opens the new Apply Now at /apply-new. It simulates every step when
# NEXT_PUBLIC_USE_MOCKS=true or no API URL is set; on a production build it refuses instead.
# NEXT_PUBLIC_ENABLE_REDESIGN_APPLY=true
# NEXT_PUBLIC_USE_MOCKS=true
# "true" shows placeholder blog posts for design review. Never in production.
# NEXT_PUBLIC_BLOG_DEMO=true
