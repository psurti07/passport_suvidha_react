# Passport Suvidha. Copy to .env.local and fill in. Never commit real values.
#
# With no settings, a build is the frontend demo: Apply Now runs on the demo adapter (test code
# 1234, nothing is sent, no payment), all pages are noindex, tracking and chat are off.

# --- Original application settings (its own pages and route handlers) -----------------
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_FRONTEND_URL=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_RAZORPAY_KEY=
NEXT_PUBLIC_CASHFREE_MODE=

# --- Going live: only after docs/APPLY_NOW_DEVELOPER_HANDOVER.md is complete ----------
# NEXT_PUBLIC_SITE_ENV=production        # indexable; Apply Now can never simulate
# NEXT_PUBLIC_SITE_URL=https://passportsuvidha.com
# NEXT_PUBLIC_USE_MOCKS=false            # Apply Now uses the backend
# NEXT_PUBLIC_ENABLE_TRACKING=true
# NEXT_PUBLIC_ENABLE_CHAT=true
# NEXT_PUBLIC_ENABLE_PAYMENT_SCRIPTS=true

