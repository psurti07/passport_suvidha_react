# Defaults for production builds (public flags only; never put secrets here).
# Real environment variables and .env.local override these. Staging and preview
# deployments must override them: see .env.example.
NEXT_PUBLIC_SITE_ENV=production
NEXT_PUBLIC_SITE_URL=https://passportsuvidha.com
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_ENABLE_TRACKING=true
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_PAYMENT_SCRIPTS=true
NEXT_PUBLIC_ENABLE_REDESIGN_APPLY=false
